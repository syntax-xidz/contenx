install_openclash() {
    log_blue "=========================================="
    log_blue "        INSTALLING OPENCLASH"
    log_blue "=========================================="
    
    local pkg_ext=".ipk"
    if [ "$VEROP" = "25.12.x" ]; then
        pkg_ext=".apk"
    fi
    
    select_openclash_repo
    select_install_type
    
    mkdir -p /tmp/openclash /etc/openclash/core
    
    if [ "$INSTALL_TYPE" = "full" ]; then
        log_info "Installing dependencies..."
        update_package_list_once
        
        local dependencies="coreutils-nohup ipset ip-full libcap libcap-bin ruby ruby-yaml kmod-tun kmod-inet-diag kmod-nft-tproxy"
        
        for package in $dependencies; do
            log_info "Installing $package..."
            if install_package_simple "$package"; then
                log_info "Installed $package"
            else
                log_warn "Failed to install $package, continuing..."
            fi
        done
    fi
    
    log_info "Fetching OpenClash Package URL..."
    
    if [[ "$OPENCLASH_REPO" == *"vernesong"* ]]; then
        log_info "Searching in Official repository (all releases)..."
        openclash_pkg_url=$(curl -s "https://api.github.com/repos/vernesong/OpenClash/releases" | grep "browser_download_url" | grep -oE "https.*${openclash_file_name}.*\\${pkg_ext}" | head -n 1)
    else
        log_info "Searching in Modified repository..."
        openclash_pkg_url=$(curl -s "$OPENCLASH_REPO" | grep "browser_download_url" | grep -oE "https.*${openclash_file_name}.*\\${pkg_ext}" | head -n 1)
    fi
    
    if [ -z "$openclash_pkg_url" ]; then
        log_warn "Package not found, trying alternative repository..."
        if [[ "$OPENCLASH_REPO" == *"vernesong"* ]]; then
            openclash_pkg_url=$(curl -s "https://api.github.com/repos/Yogxx/OpenClash/releases" | grep "browser_download_url" | grep -oE "https.*${openclash_file_name}.*\\${pkg_ext}" | head -n 1)
        else
            openclash_pkg_url=$(curl -s "https://api.github.com/repos/vernesong/OpenClash/releases" | grep "browser_download_url" | grep -oE "https.*${openclash_file_name}.*\\${pkg_ext}" | head -n 1)
        fi
    fi
    
    if [ -z "$openclash_pkg_url" ]; then
        log_error "Failed to get OpenClash Package URL from both repositories"
        log_error "Please check your internet connection or try again later"
        return 1
    fi
    
    download_file "$openclash_pkg_url" "/tmp/openclash/openclash${pkg_ext}" || return 1
    
    echo ""
    log_blue "Install Mihomo Core untuk OpenClash?"
    echo ""
    echo "  1) Ya - Download dan install core"
    echo "  2) Tidak - Skip install core"
    echo ""
    echo -e "${YELLOW}Auto-pilih 'Ya' dalam 5 detik...${NC}"
    echo ""
    echo -n "Pilih [1-2]: "
    
    local install_core=true
    if read -t 5 core_choice; then
        echo ""
        if [ "$core_choice" = "2" ]; then
            install_core=false
            log_info "Skip install Mihomo Core"
        else
            log_info "Install Mihomo Core"
        fi
    else
        echo ""
        log_info "Auto-pilih: Install Mihomo Core"
    fi
    
    if [ "$install_core" = true ]; then
        log_info "Fetching Mihomo Core..."
        if [[ "${ARCH_3}" == "x86_64" ]]; then
            meta_file="mihomo-linux-${ARCH_1}-compatible"
        else
            meta_file="mihomo-linux-${ARCH_1}"
        fi
        
        local mihomo_core_url=""
        local version_info=""
        
        if [ "$CORE_VERSION_TYPE" = "alpha" ]; then
            mihomo_core_url=$(curl -s "https://api.github.com/repos/MetaCubeX/mihomo/releases/tags/Prerelease-Alpha" | grep "browser_download_url" | grep -oE "https.*${meta_file}-alpha-[a-zA-Z0-9]+\.gz" | head -n 1)
            version_info=$(echo "$mihomo_core_url" | grep -oE "alpha-[a-zA-Z0-9]+")
        elif [ "$CORE_VERSION_TYPE" = "alpha-smart" ]; then
            mihomo_core_url=$(curl -s "https://api.github.com/repos/vernesong/mihomo/releases/tags/Prerelease-Alpha" | grep "browser_download_url" | grep -oE "https.*${meta_file}-alpha-smart-[a-zA-Z0-9]+\.gz" | head -n 1)
            version_info=$(echo "$mihomo_core_url" | grep -oE "alpha-smart-[a-zA-Z0-9]+")
        else
            mihomo_core_url=$(curl -s "https://api.github.com/repos/MetaCubeX/mihomo/releases/latest" | grep "browser_download_url" | grep -oE "https.*${meta_file}-v[0-9]+\.[0-9]+\.[0-9]+\.gz" | head -n 1)
            version_info=$(echo "$mihomo_core_url" | grep -oE "v[0-9]+\.[0-9]+\.[0-9]+")
        fi
        
        if [ -z "$mihomo_core_url" ]; then
            log_error "Failed to get Mihomo Core for ${meta_file}"
            log_warn "Lanjutkan install tanpa core"
        else
            log_info "Mihomo Core version: $version_info (${CORE_VERSION_TYPE^^})"
            
            if download_file "$mihomo_core_url" "/tmp/openclash/clash_meta.gz"; then
                log_info "Extracting Mihomo Core..."
                if gzip -d /tmp/openclash/clash_meta.gz 2>/dev/null; then
                    mv /tmp/openclash/clash_meta /etc/openclash/core/
                    chmod +x /etc/openclash/core/clash_meta
                    log_info "Mihomo Core installed with executable permission"
                else
                    log_warn "Gagal ekstrak core, lanjutkan tanpa core"
                fi
            else
                log_warn "Gagal download core, lanjutkan tanpa core"
            fi
        fi
    fi
    
    echo ""
    if [ "$INSTALL_TYPE" = "pkg" ]; then
        update_package_list_once
    fi
    echo ""
    
    log_info "Installing OpenClash Package..."
    if install_package_simple "/tmp/openclash/openclash${pkg_ext}"; then
        log_info "OpenClash installed successfully"
        rm -rf /tmp/openclash
        INSTALL_SUCCESS=true
        return 0
    else
        log_error "Failed to install OpenClash"
        return 1
    fi
}

install_passwall() {
    log_blue "=========================================="
    log_blue "             INSTALL PASSWALL"
    log_blue "=========================================="
    echo ""
    
    local pkg_ext=".ipk"
    local ext_regex="\.ipk"
    
    if [[ "${VEROP:-}" == 25.12* ]]; then
        pkg_ext=".apk"
        ext_regex="\.apk"
    fi
    
    mkdir -p /tmp/passwall/deps
    mkdir -p /tmp/passwall/app
    
    log_blue "=========================================="
    log_blue "        DOWNLOAD DEPENDS"
    log_blue "=========================================="
    
    local CLEAN_VEROP="${VEROP%.x}"
    local IMRT_BASE_URL="https://downloads.immortalwrt.org/releases/packages-${CLEAN_VEROP:-24.10}/${ARCH_3}"
    
    declare -a pw_deps=(
        "chinadns-ng|${IMRT_BASE_URL}/packages"
        "dns2socks|${IMRT_BASE_URL}/packages"
        "tcping|${IMRT_BASE_URL}/packages"
        "dns2tcp|${IMRT_BASE_URL}/packages"
    )
    
    for dep in "${pw_deps[@]}"; do
        local pkg_name="${dep%%|*}"
        local pkg_repo="${dep##*|}"
        
        # Perbaikan regex: Menambahkan ~ dan + ke dalam kurung siku
        local pkg_file=$(curl -sL "$pkg_repo/" | grep -oE "${pkg_name}[_-][a-zA-Z0-9_.~+-]+${pkg_ext}" | head -n 1)
        
        if [[ -n "$pkg_file" ]]; then
            log_info "Download: $pkg_file"
            download_file "$pkg_repo/$pkg_file" "/tmp/passwall/deps/$pkg_file"
        else
            log_error "Gagal menemukan $pkg_name di repository"
        fi
    done
    
    log_blue "=========================================="
    log_blue "         DOWNLOAD LUCI-APP-PASSWALL"
    log_blue "=========================================="
    
    local pw_search="luci-app-passwall"
    if [[ "${VEROP:-}" == 25.12* ]]; then
        pw_search="25\.12(%2B|\+)_luci-app-passwall"
    elif [[ "${VEROP:-}" == 24.10* || "${VEROP:-}" == 23.05* ]]; then
        pw_search="23\.05-24\.10_luci-app-passwall"
    fi
    
    local release_data=$(curl -s "https://api.github.com/repos/Openwrt-Passwall/openwrt-passwall/releases/latest")
    
    local pw_ipk=$(echo "$release_data" | jq -r '.assets[].browser_download_url' | grep -iE "${pw_search}.*${ext_regex}$" | head -n 1)
    
    [[ -z "$pw_ipk" ]] && pw_ipk=$(echo "$release_data" | jq -r '.assets[].browser_download_url' | grep -iE "luci-app-passwall.*${ext_regex}$" | head -n 1)
    
    [[ -z "$pw_ipk" ]] && { log_error "Failed to fetch Passwall URL"; rm -rf /tmp/passwall; return 1; }
    
    local clean_name=$(basename "${pw_ipk}" | sed -E 's/^.*(luci-app-passwall.*)$/\1/')
    
    log_info "Download: $(basename "$pw_ipk")"
    log_info "Menyimpan sebagai: $clean_name"
    
    if ! download_file "$pw_ipk" "/tmp/passwall/app/$clean_name"; then
        log_error "Gagal download Passwall"
        rm -rf /tmp/passwall
        return 1
    fi
    
    echo ""
    update_package_list_once
    echo ""
    
    log_blue "=========================================="
    log_blue "         INSTALL DEPENDS"
    log_blue "=========================================="
    
    log_info "Installing dependencies..."
    local deps_status=0
    
    if [[ "${VEROP:-}" == 25.12* ]]; then
        apk add --allow-untrusted /tmp/passwall/deps/*.apk || deps_status=1
    else
        opkg install /tmp/passwall/deps/*.ipk || deps_status=1
    fi
    
    if [[ $deps_status -ne 0 ]]; then
        log_error "Peringatan: Terdapat error saat install dependencies, melanjutkan..."
    fi
    
    log_blue "=========================================="
    log_blue "         INSTALL LUCI-APP-PASSWALL"
    log_blue "=========================================="
    
    log_info "Installing Passwall..."
    local pw_status=0
    
    if [[ "${VEROP:-}" == 25.12* ]]; then
        apk add --allow-untrusted /tmp/passwall/app/*.apk || pw_status=1
    else
        opkg install /tmp/passwall/app/*.ipk || pw_status=1
    fi
    
    if [[ $pw_status -eq 0 ]]; then
        log_info "✓ Passwall dan dependencies berhasil diinstall"
        rm -rf /tmp/passwall
        return 0
    else
        log_error "✗ Gagal install Passwall"
        rm -rf /tmp/passwall
        return 1
    fi
}

