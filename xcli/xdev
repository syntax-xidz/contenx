openwrt_auto_mount() {
    local dev=$1 mnt=$2 fstype=$3
    [[ -z "$mnt" ]] && mnt="/mnt/$(basename "$dev")"
    [[ -z "$fstype" ]] && fstype=$(blkid -o value -s TYPE "$dev" 2>/dev/null)
    
    mkdir -p "$mnt"
    umount "$mnt" >/dev/null 2>&1
    umount "$dev" >/dev/null 2>&1
    
    local uuid=$(blkid -o value -s UUID "$dev" 2>/dev/null)
    if [[ -n "$uuid" ]]; then
        local uci_sec=$(uci show fstab 2>/dev/null | grep -E "target='$mnt'|uuid='$uuid'|device='$dev'" | cut -d. -f2 | cut -d= -f1 | head -n1)
        if [[ -z "$uci_sec" ]]; then
            uci add fstab mount >/dev/null 2>&1
            uci_sec=$(uci show fstab 2>/dev/null | grep "=mount" | tail -n1 | cut -d. -f2 | cut -d= -f1)
        fi
        uci set fstab.${uci_sec}.uuid="$uuid" >/dev/null 2>&1
        uci set fstab.${uci_sec}.target="$mnt" >/dev/null 2>&1
        uci set fstab.${uci_sec}.fstype="${fstype:-auto}" >/dev/null 2>&1
        uci set fstab.${uci_sec}.options="rw,sync" >/dev/null 2>&1
        uci set fstab.${uci_sec}.enabled="1" >/dev/null 2>&1
        uci commit fstab >/dev/null 2>&1
        block mount >/dev/null 2>&1
    fi
    
    if ! mountpoint -q "$mnt" 2>/dev/null; then
        mount "$dev" "$mnt" >/dev/null 2>&1
    fi
}

expand_rootfs() {
    log_blue "=========================================="
    log_blue "              EXPAND ROOTFS"
    log_blue "=========================================="
    echo ""

    local part_dev fstype disk_dev part_num
    local adj_num adj_dev adj_fstype adj_mount
    local adj_start_s adj_end_s adj_size_mib adj_used_mib adj_margin_mib safe_shrink_mib
    local root_start_s root_end_s disk_total_s free_s free_mib total_available_mib request_mib
    local from_free_mib from_adj_mib new_root_end_s new_adj_start_s
    local backup_dir sfdisk_backup backup_tar table_type
    local parted_out resize_out

    part_dev=$(detect_root_partition)
    if [[ -z "$part_dev" || ! -b "$part_dev" ]]; then
        log_error "Tidak dapat mendeteksi partisi rootfs aktif"
        return 1
    fi

    fstype=$(blkid -o value -s TYPE "$part_dev" 2>/dev/null)

    case "$fstype" in
        ext2|ext3|ext4|f2fs|btrfs)
            ;;
        squashfs|jffs2|ubifs)
            log_error "Filesystem '$fstype' berbasis NAND/UBI, tidak didukung"
            return 1
            ;;
        *)
            log_error "Filesystem '$fstype' tidak dikenali"
            return 1
            ;;
    esac

    disk_dev="/dev/$(lsblk -no PKNAME "$part_dev" 2>/dev/null)"
    part_num=$(echo "$part_dev" | grep -oE '[0-9]+$')

    if [[ -z "$disk_dev" || ! -b "$disk_dev" || -z "$part_num" ]]; then
        log_error "Gagal mendeteksi disk induk / nomor partisi dari $part_dev"
        return 1
    fi

    log_info "OpenWrt version : $VEROP"
    log_info "Partisi rootfs  : $part_dev"
    log_info "Disk induk      : $disk_dev"
    log_info "Filesystem      : $fstype"
    echo ""

    root_start_s=$(parted_part_field "$disk_dev" "$part_num" 2 s | tr -cd '0-9')
    root_end_s=$(parted_part_field "$disk_dev" "$part_num" 3 s | tr -cd '0-9')
    disk_total_s=$(parted -sm "$disk_dev" unit s print 2>/dev/null | awk -F: 'NR==2 {gsub(/[^0-9]/,"",$2); print $2}')

    local adj_info
    adj_info=$(parted -sm "$disk_dev" unit s print 2>/dev/null | awk -F: -v re="$root_end_s" -v rp="$part_num" '
        $1 ~ /^[0-9]+$/ && $1 != rp {
            start=$2; gsub(/[^0-9]/, "", start)
            re_num=re; gsub(/[^0-9]/, "", re_num)
            if (start+0 >= re_num+0) { 
                print $1":"start 
            }
        }
    ' | sort -t: -k2 -n | head -n1)

    safe_shrink_mib=0

    if [[ -n "$adj_info" ]]; then
        adj_num=$(echo "$adj_info" | cut -d: -f1)
        adj_start_s=$(echo "$adj_info" | cut -d: -f2)
        adj_end_s=$(parted_part_field "$disk_dev" "$adj_num" 3 s | tr -cd '0-9')
        
        local prefix
        prefix=$(echo "$part_dev" | sed -E "s/[0-9]+$//")
        adj_dev="${prefix}${adj_num}"

        free_s=$(( adj_start_s - root_end_s - 1 ))
        [[ $free_s -lt 0 ]] && free_s=0

        adj_fstype=$(blkid -o value -s TYPE "$adj_dev" 2>/dev/null)
        adj_mount=$(mount 2>/dev/null | awk -v d="$adj_dev" '$1==d{print $3}')

        if [[ "$adj_mount" == "/boot" || "$adj_mount" == "/boot/efi" || "$adj_num" -eq 1 ]]; then
            log_info "Partisi terdeteksi sebagai /boot. Sistem mengecualikan partisi ini dari modifikasi!"
            adj_dev=""
            adj_mount=""
        fi

        if [[ -n "$adj_dev" && -n "$adj_mount" ]]; then
            local adj_size_s=$(( adj_end_s - adj_start_s ))
            adj_size_mib=$(( adj_size_s / 2048 ))
            adj_used_mib=$(df -k "$adj_mount" 2>/dev/null | awk 'NR==2{print int($3/1024)}')
            [[ -z "$adj_used_mib" ]] && adj_used_mib=$adj_size_mib
            
            local adj_free_mib=$(( adj_size_mib - adj_used_mib ))
            adj_margin_mib=$(compute_safe_margin_mb "$adj_size_mib" "$adj_fstype")
            safe_shrink_mib=$(( adj_free_mib - adj_margin_mib ))
            [[ $safe_shrink_mib -lt 0 ]] && safe_shrink_mib=0
        elif [[ -n "$adj_dev" && -z "$adj_mount" ]]; then
            adj_dev="" 
        fi
    else
        adj_dev=""
        free_s=$(( disk_total_s - root_end_s - 34 ))
        [[ $free_s -lt 0 ]] && free_s=0
    fi

    free_mib=$(( free_s / 2048 ))
    total_available_mib=$(( free_mib + safe_shrink_mib ))

    log_info "Ruang kosong di sebelah rootfs: ${free_mib} MiB"
    if [[ -n "$adj_dev" ]]; then
        log_info "Adjacent Partition aktif  : $adj_dev ($adj_fstype) di $adj_mount"
        log_info "Ukuran Adjacent           : ${adj_size_mib} MiB, terpakai ${adj_used_mib} MiB"
        log_info "Maks aman diambil         : ${safe_shrink_mib} MiB"
    fi
    log_info "Total maksimum bisa expand  : ${total_available_mib} MiB"
    echo ""

    if [[ $total_available_mib -le 0 ]]; then
        log_error "Tidak ada ruang untuk melakukan expand rootfs"
        return 1
    fi

    echo -n "Masukkan ukuran expand rootfs (MiB), maks ${total_available_mib}: "
    read request_mib

    if ! [[ "$request_mib" =~ ^[0-9]+$ ]] || [[ "$request_mib" -le 0 ]]; then
        log_error "Input tidak valid"
        return 1
    fi

    if [[ "$request_mib" -gt "$total_available_mib" ]]; then
        log_error "Ukuran melebihi batas aman (${total_available_mib} MiB)"
        return 1
    fi

    if [[ "$request_mib" -le "$free_mib" ]]; then
        from_free_mib=$request_mib
        from_adj_mib=0
    else
        from_free_mib=$free_mib
        from_adj_mib=$((request_mib - free_mib))
    fi

    if [[ "$request_mib" -eq "$total_available_mib" && $from_adj_mib -eq 0 ]]; then
        if [[ -n "$adj_info" ]]; then
            new_root_end_s=$(( adj_start_s - 1 ))
        else
            new_root_end_s=$(( disk_total_s - 34 ))
        fi
    else
        new_root_end_s=$(( root_end_s + (request_mib * 2048) ))
    fi

    log_info "Dari ruang kosong    : ${from_free_mib} MiB"
    [[ $from_adj_mib -gt 0 ]] && log_info "Dari $adj_dev       : ${from_adj_mib} MiB"
    log_info "Rootfs akan bertambah: +${request_mib} MiB"
    echo -n "Lanjutkan expand? [y/N]: "
    read confirm
    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        log_info "Dibatalkan oleh pengguna"
        return 0
    fi

    backup_dir="/root/rootfs_backup"
    mkdir -p "$backup_dir"
    sfdisk_backup="${backup_dir}/parttable_$(basename "$disk_dev")_$(date +%Y%m%d%H%M%S).sfdisk"

    if command -v sfdisk >/dev/null 2>&1; then
        sfdisk -d "$disk_dev" > "$sfdisk_backup" 2>/dev/null
    fi

    if [[ ! -s "$sfdisk_backup" ]]; then
        log_error "Gagal membuat backup partition table. Pastikan sfdisk terinstal."
        return 1
    fi
    log_info "Backup partition table: $sfdisk_backup"

    if [[ $from_adj_mib -gt 0 ]]; then
        backup_tar=$(pick_backup_location "$adj_used_mib")
        if [[ -z "$backup_tar" ]]; then
            log_error "Tidak ada lokasi dengan ruang cukup untuk backup data $adj_dev"
            return 1
        fi

        tar -czf "$backup_tar" -C "$adj_mount" . >/dev/null 2>&1 || true
        if [[ ! -s "$backup_tar" ]] || ! tar -tzf "$backup_tar" >/dev/null 2>&1; then
            log_error "Backup data $adj_dev gagal atau korup, dibatalkan"
            rm -f "$backup_tar"
            return 1
        fi
        log_info "Backup data tersimpan: $backup_tar"

        umount "$adj_mount" >/dev/null 2>&1
        if mountpoint -q "$adj_mount" 2>/dev/null; then
            log_error "Gagal unmount $adj_mount, dibatalkan"
            rm -f "$backup_tar"
            return 1
        fi

        wipefs -a "$adj_dev" >/dev/null 2>&1
        dd if=/dev/zero of="$adj_dev" bs=1M count=10 >/dev/null 2>&1
        refresh_kernel_partitions "$disk_dev"

        if ! parted_out=$(parted -s "$disk_dev" rm "$adj_num" 2>&1); then
            log_error "Gagal menghapus partisi $adj_dev. Output: $parted_out"
            restore_and_remount "$disk_dev" "$sfdisk_backup" "$adj_dev" "$adj_mount"
            rm -f "$backup_tar"
            return 1
        fi
    fi

    if ! parted_out=$(do_resizepart_rootfs "$disk_dev" "$part_num" "$new_root_end_s" "$root_start_s" "$sfdisk_backup"); then
        log_error "Gagal meregangkan partisi rootfs. Output: $parted_out"
        if [[ $from_adj_mib -gt 0 ]]; then
            restore_and_remount "$disk_dev" "$sfdisk_backup" "$adj_dev" "$adj_mount"
            rm -f "$backup_tar"
        fi
        return 1
    fi

    if [[ $from_adj_mib -gt 0 ]]; then
        new_adj_start_s=$(( new_root_end_s + 1 ))
        table_type=$(disk_table_type "$disk_dev")

        if [[ "$table_type" == "gpt" ]]; then
            parted -s "$disk_dev" mkpart "$(basename "$adj_dev")" "${new_adj_start_s}s" "${adj_end_s}s" >/dev/null 2>&1
        else
            parted -s "$disk_dev" mkpart primary "${new_adj_start_s}s" "${adj_end_s}s" >/dev/null 2>&1
        fi

        refresh_kernel_partitions "$disk_dev"

        if [[ ! -b "$adj_dev" ]]; then
            log_error "Gagal membuat ulang partisi $adj_dev"
            log_error "Data masih ada di $backup_tar, restore manual dari $sfdisk_backup"
            return 1
        fi

        if ! format_partition "$adj_dev" "$adj_fstype"; then
            log_error "Gagal format ulang $adj_dev"
            log_error "Data masih ada di $backup_tar, restore manual dari $sfdisk_backup"
            return 1
        fi

        openwrt_auto_mount "$adj_dev" "$adj_mount" "$adj_fstype"

        if ! mountpoint -q "$adj_mount" 2>/dev/null; then
            log_error "Gagal auto-mount $adj_dev, data ada di $backup_tar"
            return 1
        fi

        if ! tar -xzf "$backup_tar" -C "$adj_mount" 2>/dev/null; then
            log_error "Gagal restore data ke $adj_dev, backup dipertahankan di $backup_tar"
            return 1
        fi

        local restored_count original_count
        original_count=$(tar -tzf "$backup_tar" 2>/dev/null | wc -l)
        restored_count=$(find "$adj_mount" -mindepth 1 2>/dev/null | wc -l)
        if [[ "$original_count" -gt 0 && "$restored_count" -lt 1 ]]; then
            log_error "Verifikasi restore data gagal, backup dipertahankan di $backup_tar"
            return 1
        fi

        rm -f "$backup_tar"
    else
        refresh_kernel_partitions "$disk_dev"
    fi

    log_info "Melakukan online-resize filesystem rootfs ($fstype)..."
    if ! resize_out=$(resize_filesystem "$part_dev" "$fstype" 2>&1); then
        log_error "Tabel partisi diperbesar, tapi sistem gagal mengenali ukurannya."
        log_error "Pesan BTRFS/Resize2fs: $resize_out"
        return 1
    fi

    log_blue "=========================================="
    log_info "Rootfs berhasil di-expand +${request_mib} MiB"
    log_blue "=========================================="
    if [[ $from_adj_mib -gt 0 ]]; then
        df -h / "$adj_mount" 2>/dev/null
    else
        df -h / 2>/dev/null
    fi
}

check_rootfs_info() {
    log_blue "=========================================="
    log_blue "            INFO ROOTFS SAAT INI"
    log_blue "=========================================="
    echo ""

    local part_dev fstype disk_dev

    part_dev=$(detect_root_partition)
    if [[ -z "$part_dev" || ! -b "$part_dev" ]]; then
        log_error "Tidak dapat mendeteksi partisi rootfs aktif"
        return 1
    fi

    fstype=$(blkid -o value -s TYPE "$part_dev" 2>/dev/null)
    disk_dev="/dev/$(lsblk -no PKNAME "$part_dev" 2>/dev/null)"

    log_info "OpenWrt version : $VEROP"
    log_info "Partisi rootfs  : $part_dev"
    log_info "Disk induk      : $disk_dev"
    log_info "Filesystem      : ${fstype:-tidak diketahui}"
    echo ""
    df -h / 2>/dev/null
    echo ""
    lsblk "$disk_dev" 2>/dev/null
}

restore_partition_backup() {
    log_blue "=========================================="
    log_blue "     RESTORE & RESIZE (SHRINK / TRANSFER)"
    log_blue "=========================================="
    echo ""

    local rootfs_dev=$(detect_root_partition)
    local disk_dev="/dev/$(lsblk -no PKNAME "$rootfs_dev" 2>/dev/null)"
    
    if [[ -z "$disk_dev" || ! -b "$disk_dev" ]]; then
        log_error "Gagal mendeteksi disk induk."
        return 1
    fi

    log_info "Memindai daftar partisi pada $disk_dev..."
    echo ""
    
    local parts=()
    local i=1
    
    while IFS=: read -r pnum start end size fstype name flags; do
        if [[ "$pnum" =~ ^[0-9]+$ ]]; then
            local pdev="${disk_dev}p${pnum}"
            [[ ! -b "$pdev" ]] && pdev="${disk_dev}${pnum}"
            
            local p_mib=$(echo "$size" | tr -cd '0-9')
            local p_real_fstype=$(blkid -o value -s TYPE "$pdev" 2>/dev/null)
            [[ -z "$p_real_fstype" ]] && p_real_fstype="unknown"
            
            local is_root=""
            [[ "$pdev" == "$rootfs_dev" ]] && is_root="(ROOTFS)"

            printf "  %2d) %-15s | %-8s | %5s MiB %s\n" "$i" "$pdev" "$p_real_fstype" "$p_mib" "$is_root"
            
            parts+=("$pdev|$p_mib|$p_real_fstype|$pnum")
            i=$((i+1))
        fi
    done < <(parted -sm "$disk_dev" unit MiB print 2>/dev/null | tail -n +3)

    if [[ ${#parts[@]} -lt 2 ]]; then
        log_error "Minimal membutuhkan 2 partisi untuk transfer kapasitas."
        return 1
    fi

    echo ""
    echo -n "Pilih partisi SUMBER untuk DIKURANGI ukurannya [1-${#parts[@]}], 0 batal: "
    read src_idx

    if [[ "$src_idx" == "0" || -z "$src_idx" ]]; then
        log_info "Dibatalkan."
        return 0
    fi

    if [[ "$src_idx" -lt 1 || "$src_idx" -gt ${#parts[@]} ]]; then
        log_error "Pilihan sumber tidak valid."
        return 1
    fi

    local src_info="${parts[$((src_idx-1))]}"
    local src_dev=$(echo "$src_info" | cut -d'|' -f1)
    local src_mib=$(echo "$src_info" | cut -d'|' -f2)
    local src_fstype=$(echo "$src_info" | cut -d'|' -f3)
    local src_pnum=$(echo "$src_info" | cut -d'|' -f4)

    local src_mount=$(mount 2>/dev/null | awk -v d="$src_dev" '$1==d{print $3}')
    if [[ -n "$src_mount" ]]; then
        if [[ "$src_fstype" != "ext2" && "$src_fstype" != "ext3" && "$src_fstype" != "ext4" && "$src_fstype" != "btrfs" ]]; then
             log_error "Partisi $src_dev ($src_fstype) sedang dimount di $src_mount."
             log_error "Hanya EXT2/3/4 atau BTRFS yang mendukung online shrinking dengan aman."
             return 1
        fi
    fi

    echo -n "Pilih partisi TUJUAN untuk DITAMBAHKAN ukurannya [1-${#parts[@]}], 0 batal: "
    read dst_idx
    
    if [[ "$dst_idx" == "0" || -z "$dst_idx" ]]; then
        log_info "Dibatalkan."
        return 0
    fi

    if [[ "$dst_idx" -eq "$src_idx" ]]; then
        log_error "Partisi sumber dan tujuan tidak boleh sama."
        return 1
    fi

    local dst_info="${parts[$((dst_idx-1))]}"
    local dst_dev=$(echo "$dst_info" | cut -d'|' -f1)
    
    local min_src_mib=32
    if [[ "$src_dev" == "$rootfs_dev" ]]; then
        min_src_mib=768
    fi

    local max_shrink=$(( src_mib - min_src_mib ))
    
    if [[ $max_shrink -le 0 ]]; then
        log_error "Partisi $src_dev terlalu kecil (sekarang ${src_mib} MiB). Batas minimal adalah ${min_src_mib} MiB."
        return 1
    fi

    echo ""
    log_info "Sumber : $src_dev (Kapasitas saat ini: ${src_mib} MiB)"
    if [[ "$src_dev" == "$rootfs_dev" ]]; then
        log_info "Sistem Proteksi: Rootfs tidak boleh lebih kecil dari 768 MiB."
    fi
    log_info "Tujuan : $dst_dev"
    echo ""
    echo -n "Masukkan jumlah ukuran yang ingin DIKURANGI dari sumber (MiB), maks ${max_shrink}: "
    read shrink_mib

    if ! [[ "$shrink_mib" =~ ^[0-9]+$ ]] || [[ "$shrink_mib" -le 0 ]] || [[ "$shrink_mib" -gt "$max_shrink" ]]; then
        log_error "Input ukuran tidak valid."
        return 1
    fi
    
    log_error "PERINGATAN: Fitur Shrink berisiko tinggi. Jika file sedang digunakan, filesystem bisa korup."
    echo -n "Lanjutkan Shrink & Transfer ${shrink_mib} MiB dari $src_dev ke $dst_dev? [y/N]: "
    read confirm
    if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
        log_info "Dibatalkan."
        return 0
    fi

    log_info "Mengamankan data dan memproses transfer..."
    sleep 2
    
    log_info "Fitur transfer logic eksekusi diblokir sementara demi keamanan tingkat sektor."
    log_info "Pada Linux, transfer kapasitas acak (non-contiguous) membutuhkan backup/wipe/restore LVM secara penuh."
    return 1
}

create_new_partition() {
    log_blue "=========================================="
    log_blue "            BUAT PARTISI BARU"
    log_blue "=========================================="
    echo ""

    local root_dev=$(detect_root_partition)
    local disk_dev="/dev/$(lsblk -no PKNAME "$root_dev" 2>/dev/null)"
    
    if [[ -z "$disk_dev" || ! -b "$disk_dev" ]]; then
        log_error "Gagal mendeteksi disk induk"
        return 1
    fi
    
    local last_part_info=$(parted -sm "$disk_dev" unit s print 2>/dev/null | awk -F: '/^[0-9]+/ {pnum=$1; start=$2; end=$3; gsub(/[^0-9]/,"",start); gsub(/[^0-9]/,"",end)} END {print pnum":"start":"end}')
    
    local last_pnum=$(echo "$last_part_info" | cut -d: -f1)
    local last_start_s=$(echo "$last_part_info" | cut -d: -f2)
    local last_end_s=$(echo "$last_part_info" | cut -d: -f3)
    
    local prefix=$(echo "$root_dev" | sed -E "s/[0-9]+$//")
    local last_pdev="${prefix}${last_pnum}"
    
    local disk_total_s=$(parted -sm "$disk_dev" unit s print 2>/dev/null | awk -F: 'NR==2 {gsub(/[^0-9]/,"",$2); print $2}')
    
    local unallocated_s=$(( disk_total_s - last_end_s - 34 ))
    [[ $unallocated_s -lt 0 ]] && unallocated_s=0
    local unallocated_mib=$(( unallocated_s / 2048 ))
    
    local last_fstype=$(blkid -o value -s TYPE "$last_pdev" 2>/dev/null)
    local last_mount=$(mount 2>/dev/null | awk -v d="$last_pdev" '$1==d{print $3}')
    
    local safe_shrink_mib=0
    local last_size_mib=$(( (last_end_s - last_start_s) / 2048 ))
    
    if [[ -n "$last_mount" ]]; then
        local last_used_mib=$(df -k "$last_mount" 2>/dev/null | awk 'NR==2{print int($3/1024)}')
        [[ -z "$last_used_mib" ]] && last_used_mib=$last_size_mib
        local last_free_mib=$(( last_size_mib - last_used_mib ))
        local margin_mib=$(compute_safe_margin_mb "$last_size_mib" "$last_fstype")
        safe_shrink_mib=$(( last_free_mib - margin_mib ))
        [[ $safe_shrink_mib -lt 0 ]] && safe_shrink_mib=0
        
        if [[ "$last_fstype" =~ ^(ext2|ext3|ext4)$ ]]; then
            safe_shrink_mib=0
        fi
    fi

    local total_available_mib=$(( unallocated_mib + safe_shrink_mib ))

    log_info "Disk target        : $disk_dev"
    log_info "Partisi Terakhir   : $last_pdev ($last_fstype)"
    log_info "Ruang Unallocated  : ${unallocated_mib} MiB"
    
    if [[ $safe_shrink_mib -gt 0 ]]; then
        log_info "Potensi Shrink ($last_fstype) : ${safe_shrink_mib} MiB (Maksimum aman)"
    elif [[ "$last_fstype" =~ ^(ext2|ext3|ext4)$ && -n "$last_mount" ]]; then
        log_info "Potensi Shrink     : 0 MiB (EXT4 aktif tidak mendukung online-shrink)"
    fi
    
    log_info "Total Kapasitas    : ${total_available_mib} MiB"
    echo ""

    if [[ $total_available_mib -le 0 ]]; then
        log_error "Tidak ada ruang kosong untuk membuat partisi baru."
        return 1
    fi

    echo -n "Masukkan ukuran partisi baru (MiB), maks ${total_available_mib}: "
    read req_mib

    if ! [[ "$req_mib" =~ ^[0-9]+$ ]] || [[ "$req_mib" -le 0 ]] || [[ "$req_mib" -gt "$total_available_mib" ]]; then
        log_error "Input ukuran tidak valid."
        return 1
    fi

    echo -n "Pilih filesystem (ext4/f2fs/btrfs/vfat) [ext4]: "
    read new_fstype
    new_fstype=${new_fstype:-ext4}

    local need_shrink_mib=$(( req_mib - unallocated_mib ))
    local new_part_start_s
    
    if [[ $need_shrink_mib -gt 0 ]]; then
        log_info "Membutuhkan shrink sebesar ${need_shrink_mib} MiB dari $last_pdev..."
        
        if [[ "$last_fstype" != "btrfs" ]]; then
            log_error "Saat ini script hanya mendukung online shrink untuk BTRFS."
            return 1
        fi
        
        local shrink_target_fs=$(( need_shrink_mib + 32 ))
        local current_fs_size_mib=$(df -k "$last_mount" 2>/dev/null | awk 'NR==2{print int($2/1024)}')
        local target_fs_mib=$(( current_fs_size_mib - shrink_target_fs ))
        
        log_info "Menyesuaikan ukuran filesystem BTRFS ke ${target_fs_mib} MiB..."
        btrfs filesystem resize ${target_fs_mib}M "$last_mount" >/dev/null 2>&1
        if [[ $? -ne 0 ]]; then
            log_error "Gagal shrink filesystem BTRFS."
            return 1
        fi
        
        local new_last_end_s=$(( last_end_s - (need_shrink_mib * 2048) ))
        
        local backup_dir="/root/rootfs_backup"
        mkdir -p "$backup_dir"
        local sfdisk_backup="${backup_dir}/parttable_$(basename "$disk_dev")_$(date +%Y%m%d%H%M%S).sfdisk"
        sfdisk -d "$disk_dev" > "$sfdisk_backup" 2>/dev/null
        
        if ! do_resizepart_rootfs "$disk_dev" "$last_pnum" "$new_last_end_s" "$last_start_s" "$sfdisk_backup"; then
            log_error "Gagal shrink tabel partisi $last_pdev."
            btrfs filesystem resize max "$last_mount" >/dev/null 2>&1
            return 1
        fi
        
        btrfs filesystem resize max "$last_mount" >/dev/null 2>&1
        
        last_end_s=$new_last_end_s
    fi
    
    new_part_start_s=$(( last_end_s + 1 ))
    
    local new_part_end_s
    if [[ "$req_mib" -eq "$total_available_mib" && $need_shrink_mib -le 0 ]]; then
        new_part_end_s=$(( disk_total_s - 34 ))
    else
        local req_s=$(( req_mib * 2048 ))
        new_part_end_s=$(( new_part_start_s + req_s - 1 ))
    fi

    local table_type=$(disk_table_type "$disk_dev")
    if [[ "$table_type" == "gpt" ]]; then
        parted -s "$disk_dev" mkpart "userdata" "${new_part_start_s}s" "${new_part_end_s}s" >/dev/null 2>&1
    else
        parted -s "$disk_dev" mkpart primary "${new_part_start_s}s" "${new_part_end_s}s" >/dev/null 2>&1
    fi

    refresh_kernel_partitions "$disk_dev"

    local new_part_num=$(parted -sm "$disk_dev" print 2>/dev/null | awk -F: '/^[0-9]+/ {print $1}' | sort -n | tail -1)
    local new_part_dev="${prefix}${new_part_num}"

    if [[ ! -b "$new_part_dev" ]]; then
        log_error "Gagal mendeteksi partisi yang baru dibuat."
        return 1
    fi

    case "$new_fstype" in
        vfat)
            mkfs.vfat "$new_part_dev" >/dev/null 2>&1
            ;;
        ext4)
            mkfs.ext4 -F "$new_part_dev" >/dev/null 2>&1
            ;;
        f2fs)
            mkfs.f2fs -f "$new_part_dev" >/dev/null 2>&1
            ;;
        btrfs)
            mkfs.btrfs -f "$new_part_dev" >/dev/null 2>&1
            ;;
        *)
            log_error "Filesystem $new_fstype tidak didukung format otomatis. Partisi dibuat tanpa format."
            ;;
    esac

    local new_mnt="/mnt/$(basename "$new_part_dev")"
    openwrt_auto_mount "$new_part_dev" "$new_mnt" "$new_fstype"

    log_blue "=========================================="
    log_info "Partisi baru berhasil dibuat: $new_part_dev (${req_mib} MiB, $new_fstype)"
    log_blue "=========================================="
    lsblk "$disk_dev" 2>/dev/null
}

do_resizepart_rootfs() {
    local disk=$1 pnum=$2 target_s=$3 start_s=$4 backup_file=$5
    local size_s=$(( target_s - start_s + 1 ))
    local out check_end_s diff

    awk -v dev="${disk}" -v pnum="${pnum}" -v ns="${size_s}" '
        {
            p1 = dev pnum
            p2 = dev "p" pnum
            if ($1 == p1 || $1 == p2) {
                sub(/size=[ \t]*[0-9]+/, "size=" ns)
            }
            print
        }
    ' "$backup_file" > "/tmp/new_table.sfdisk"

    out=$(sfdisk --force "$disk" < "/tmp/new_table.sfdisk" 2>&1)

    partprobe "$disk" >/dev/null 2>&1 || partx -u "$disk" >/dev/null 2>&1 || blockdev --rereadpt "$disk" >/dev/null 2>&1 || true
    sleep 1

    check_end_s=$(parted -sm "$disk" unit s print 2>/dev/null | awk -F: -v n="$pnum" '$1==n{gsub(/[^0-9]/,"",$3); print $3}')

    if [[ -z "$check_end_s" ]]; then
        echo "Sfdisk override gagal diverifikasi: $out"
        return 1
    fi

    diff=$(( check_end_s - target_s ))
    [[ $diff -lt 0 ]] && diff=$(( -diff ))

    if [[ $diff -le 4096 ]]; then
        return 0
    else
        echo "Sfdisk override output: $out"
        return 1
    fi
}

compute_safe_margin_mb() {
    local size_mb=$1 fstype=$2 permil floor_mb margin
    permil=${ROOTFS_SAFE_MARGIN_PERMIL:-125}
    floor_mb=64
    margin=$((size_mb * permil / 1000))
    [[ $margin -lt $floor_mb ]] && margin=$floor_mb
    case "$fstype" in
        btrfs)
            margin=$((margin + size_mb * 5 / 100))
            ;;
        f2fs)
            margin=$((margin + 32))
            ;;
    esac
    echo "$margin"
}

pick_backup_location() {
    local need_mb=$1
    local candidates=("/root/rootfs_backup" "/tmp")
    local dir avail
    for dir in "${candidates[@]}"; do
        [[ -d "$dir" ]] || continue
        avail=$(df -k "$dir" 2>/dev/null | awk 'NR==2{print int($4/1024)}')
        if [[ -n "$avail" && "$avail" -gt $((need_mb + 32)) ]]; then
            echo "${dir}/adjacent_backup_$(date +%Y%m%d%H%M%S).tar.gz"
            return 0
        fi
    done
    return 1
}

refresh_kernel_partitions() {
    local disk=$1
    command -v partx >/dev/null 2>&1 && partx -u "$disk" >/dev/null 2>&1
    command -v blockdev >/dev/null 2>&1 && blockdev --rereadpt "$disk" >/dev/null 2>&1
    command -v partprobe >/dev/null 2>&1 && partprobe "$disk" >/dev/null 2>&1
    command -v udevadm >/dev/null 2>&1 && udevadm settle >/dev/null 2>&1
    sleep 1
}

format_partition() {
    local dev=$1 fstype=$2
    case "$fstype" in
        ext2)
            mkfs.ext2 -F "$dev" >/dev/null 2>&1
            ;;
        ext3)
            mkfs.ext3 -F "$dev" >/dev/null 2>&1
            ;;
        ext4)
            mkfs.ext4 -F "$dev" >/dev/null 2>&1
            ;;
        btrfs)
            mkfs.btrfs -f "$dev" >/dev/null 2>&1
            ;;
        f2fs)
            mkfs.f2fs -f "$dev" >/dev/null 2>&1
            ;;
        *)
            return 1
            ;;
    esac
}

resize_filesystem() {
    local dev=$1 fstype=$2 mnt
    case "$fstype" in
        ext2|ext3|ext4)
            resize2fs "$dev"
            ;;
        btrfs)
            mnt=$(mount 2>/dev/null | awk -v d="$dev" '$1==d{print $3}')
            [[ -z "$mnt" ]] && mnt="/"
            btrfs filesystem resize max "$mnt"
            ;;
        f2fs)
            if command -v resize.f2fs >/dev/null 2>&1; then
                resize.f2fs "$dev"
            else
                echo "resize.f2fs command not found!"
                return 1
            fi
            ;;
        *)
            return 1
            ;;
    esac
}

restore_and_remount() {
    local disk=$1 sfdisk_backup=$2 adj_dev=$3 adj_mount=$4
    command -v sfdisk >/dev/null 2>&1 && sfdisk "$disk" < "$sfdisk_backup" >/dev/null 2>&1
    refresh_kernel_partitions "$disk"
    if [[ -n "$adj_mount" && -b "$adj_dev" ]]; then
        openwrt_auto_mount "$adj_dev" "$adj_mount"
    fi
    log_error "Partition table dikembalikan ke kondisi semula dari $sfdisk_backup"
}

parted_part_field() {
    local disk=$1 num=$2 field=$3 unit=${4:-MiB}
    parted -sm "$disk" unit "$unit" print 2>/dev/null | awk -F: -v n="$num" -v f="$field" -v u="$unit" '$1==n{gsub(u,"",$f); print $f}'
}

disk_table_type() {
    parted -sm "$1" print 2>/dev/null | sed -n '2p' | cut -d: -f6
}

detect_root_partition() {
    local dev

    dev=$(mount 2>/dev/null | awk '$3=="/overlay"{print $1}')

    if [[ -z "$dev" ]] && command -v block >/dev/null 2>&1; then
        dev=$(block info 2>/dev/null | grep 'MOUNT="/overlay"' | cut -d: -f1)
    fi

    if [[ -z "$dev" ]]; then
        dev=$(mount 2>/dev/null | awk '$3=="/"{print $1}')
        [[ "$dev" == "overlay" || "$dev" == overlayfs* ]] && dev=""
    fi

    if [[ -n "$dev" ]]; then
        readlink -f "$dev" 2>/dev/null || echo "$dev"
    fi
}

add_port() {
    log_blue "=========================================="
    log_blue "          ADD PORT CONFIGURATION"
    log_blue "                  V1 / V2"
    log_blue "SEBELUM GANTI VERSI RUBAH KE DEFAULT PORT"
    log_blue "=========================================="
    
    log_info "Select menu port configuration:"
    echo "1) Port V1"
    echo "2) Port V2"
    echo "3) Back to Main Menu"
    read -p "Enter your choice [1-3]: " port_choice
    
    case $port_choice in
        1)
            log_blue "=========================================="
            log_blue "          PORT  V1 CONFIGURATION"
            log_blue "    JIKA LUCI ERROR PILIH DEFAULT PORT"
            log_blue "=========================================="
            
            log_info "Select port configuration:"
            echo "1) usb0, eth1"
            echo "2) usb0, eth1, wwan0"
            echo "3) usb0, eth1, phy0-ap0"
            echo "4) usb0, eth1, eth2"
            echo "5) usb0, usb1, eth1, eth2"
            echo "6) eth1, wwan0, wwan1"
            echo "7) usb0, eth1, eth2, wwan0"
            echo "8) br-radius, usb0, eth1, wwan0"
            echo "9) Default Port"
            echo "10) Back to port Menu"
            read -p "Enter your choice [1-10]: " port_choice
            
            case $port_choice in
                1)
                    log_info "Adding ports: usb0, eth1..."
                    
                    if [ ! -f /etc/board.json.backup ]; then
                        cp /etc/board.json /etc/board.json.backup
                    else
                        cp /etc/board.json.backup /etc/board.json
                    fi
                    
                    sed -i '/"network": {/,/},/c\
	"network": {\
		"lan": {\
			"device": "eth0",\
			"protocol": "static"\
		},\
		"wan": {\
			"ports": ["usb0", "eth1"],\
			"protocol": "dhcp"\
		}\
	},' /etc/board.json
                    
                    if [ $? -eq 0 ]; then
                        log_info "Port configuration (usb0, eth1) applied successfully"
                    else
                        log_error "Port configuration failed"
                        return 1
                    fi
