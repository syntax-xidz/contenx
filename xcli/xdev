add_samba4_user() {
    log_blue "=========================================="
    log_blue "           ADD SAMBA4 USER"
    log_blue "=========================================="
    
    echo -n "Enter Username (e.g., admin): "
    read smb_user
    
    if [ -n "$smb_user" ]; then
        if ! id "$smb_user" >/dev/null 2>&1; then
            log_info "Creating system user: $smb_user..."
            useradd -M -s /bin/false "$smb_user"
        else
            log_info "System user $smb_user already exists."
        fi

        log_info "Please enter password for Samba user '$smb_user':"
        smbpasswd -a "$smb_user"
        
        if [ $? -eq 0 ]; then
            log_info "Samba4 user '$smb_user' configured successfully."
        else
            log_error "Failed to set password for '$smb_user'."
        fi
    else
        log_warn "Username is empty. Skipping user creation."
    fi
}

manage_samba_users() {
    log_blue "=========================================="
    log_blue "         MANAGE SAMBA4 USERS"
    log_blue "=========================================="
    echo ""
    
    local users=""
    if command -v pdbedit >/dev/null 2>&1; then
        users=$(pdbedit -L 2>/dev/null | cut -d: -f1)
    elif [ -f /etc/samba/smbpasswd ]; then
        users=$(cut -d: -f1 /etc/samba/smbpasswd)
    fi
    
    if [ -z "$users" ]; then
        log_warn "No Samba users found."
        samba4_menu
        return
    fi
    
    local count=0
    for u in $users; do
        count=$((count + 1))
        echo "  $count. $u"
    done
    echo "  0. exit"
    echo ""
    
    echo -n "Select user to delete [0-$count]: "
    read del_choice
    
    if [ "$del_choice" = "0" ]; then
        samba4_menu
        return
    fi
    
    local selected_user=$(echo "$users" | tr ' ' '\n' | sed -n "${del_choice}p")
    
    if [ -z "$selected_user" ]; then
        log_error "Invalid selection."
    else
        log_info "Deleting Samba user: $selected_user..."
        smbpasswd -x "$selected_user" >/dev/null 2>&1
        userdel "$selected_user" >/dev/null 2>&1
        log_info "User $selected_user deleted successfully."
    fi
    
    samba4_menu
}

configure_samba4_path() {
    log_blue "=========================================="
    log_blue "      CONFIGURING SAMBA4 SHARE PATH"
    log_blue "=========================================="
    
    log_info "Configuring basic workgroup settings..."
    uci -q set samba4.@samba[0]=samba
    uci -q set samba4.@samba[0].workgroup='WORKGROUP'
    uci -q set samba4.@samba[0].description='Samba4 on OpenWrt'
    
    echo -n "Enter Share Name (e.g., Data) [Default: Shared]: "
    read share_name
    share_name=${share_name:-Shared}
    
    log_info "Detecting mounted sda partitions..."
    mount_points=$(mount | grep -E '^/dev/sda' | awk '{print $3}')
    mount_count=$(echo "$mount_points" | awk 'NF>0' | wc -l)
    
    if [ "$mount_count" -eq 0 ]; then
        log_warn "No mounted sda partitions found."
        echo -n "Enter Share Path manually (e.g., /mnt/sda1): "
        read share_path
        if [ -z "$share_path" ]; then
            log_warn "Path cannot be empty. Defaulting to /mnt/sda1."
            share_path="/mnt/sda1"
        fi
    elif [ "$mount_count" -eq 1 ]; then
        share_path=$(echo "$mount_points" | tr -d ' \n')
        log_info "Found 1 mounted partition. Auto-selecting: $share_path"
    else
        log_info "Multiple mounted sda partitions detected:"
        i=1
        for mp in $mount_points; do
            echo "  $i) $mp"
            i=$((i + 1))
        done
        echo -n "Select path number [1-$mount_count]: "
        read path_choice
        
        share_path=$(echo "$mount_points" | sed -n "${path_choice}p")
        
        if [ -z "$share_path" ]; then
            log_warn "Invalid selection! Defaulting to the first path."
            share_path=$(echo "$mount_points" | sed -n "1p")
        fi
        log_info "Selected path: $share_path"
    fi
    
    if [ ! -d "$share_path" ]; then
        log_info "Directory $share_path not found. Creating..."
        mkdir -p "$share_path"
        chmod 0777 "$share_path"
    fi
    
    uci_id=$(echo "$share_name" | tr -dc 'a-zA-Z0-9' | tr '[:upper:]' '[:lower:]')
    [ -z "$uci_id" ] && uci_id="share1"
    
    log_info "Applying UCI configuration for share '$share_name'..."
    uci -q delete samba4.$uci_id 
    uci set samba4.$uci_id=sambashare
    uci set samba4.$uci_id.name="$share_name"
    uci set samba4.$uci_id.path="$share_path"
    uci set samba4.$uci_id.read_only='no'
    
    echo -n "Allow Guest Access (no password)? (y/n) [Default: y]: "
    read guest_choice
    guest_choice=${guest_choice:-y}
    
    if [ "$guest_choice" = "n" ] || [ "$guest_choice" = "N" ]; then
        uci set samba4.$uci_id.guest_ok='no'
    else
        uci set samba4.$uci_id.guest_ok='yes'
    fi

    echo -n "Enter Allowed Users (e.g., xidz) [Leave empty for all]: "
    read allowed_users

    if [ -n "$allowed_users" ]; then
        uci set samba4.$uci_id.users="$allowed_users"
    else
        uci -q delete samba4.$uci_id.users
    fi
    
    uci set samba4.$uci_id.create_mask='0777'
    uci set samba4.$uci_id.dir_mask='0777'
    
    uci commit samba4
    
    /etc/init.d/samba4 restart >/dev/null 2>&1
    log_info "Samba4 Share Path configured successfully."
}

