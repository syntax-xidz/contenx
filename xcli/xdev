    if [ "$original_name" != "$clean_name" ]; then
        mv "/tmp/qtun/$original_name" "/tmp/qtun/$clean_name"
        log_info "Renamed package to: $clean_name"
    fi
    
    echo ""
    update_package_list_once
    echo ""
    
    log_blue "=========================================="
    log_blue "           INSTALL LUCI-APP-QTUN"
    log_blue "=========================================="
    
    log_info "Installing Qtun $version for architecture ${ARCH_3}..."
    
    if install_package_simple "/tmp/qtun/$clean_name"; then
        log_info "✓ Qtun $version has been successfully installed."
        rm -rf /tmp/qtun
        return 0
    else
        log_error "✗ Failed to install Qtun."
        rm -rf /tmp/qtun
        return 1
    fi
}

