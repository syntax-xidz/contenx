install_samba4() {
    log_blue "=========================================="
    log_blue "          INSTALLING SAMBA4"
    log_blue "=========================================="
    echo ""
    
    log_info "Preparing Samba4 installation..."
    
    log_info "Updating package lists..."
    update_package_list_once
    
    packages="luci-app-samba4 shadow-useradd"
    for package in $packages; do
        local is_installed=false
        if [ "$VEROP" = "25.12.x" ]; then
            apk info -e "$package" >/dev/null 2>&1 && is_installed=true
        else
            opkg list-installed | grep -q "^$package" && is_installed=true
        fi
        
        if [ "$is_installed" = true ]; then
            log_info "Package $package is already installed. Removing old version..."
            if [ "$VEROP" = "25.12.x" ]; then
                apk del "$package" >/dev/null 2>&1
            else
                opkg remove "$package" --force-remove >/dev/null 2>&1
            fi
        fi
    done
    
    log_info "Installing samba4.."
    local install_failed=0
    if [ "$VEROP" = "25.12.x" ]; then
        apk add luci-app-samba4 shadow-useradd >/dev/null 2>&1 || install_failed=1
    else
        opkg install luci-app-samba4 shadow-useradd >/dev/null 2>&1 || install_failed=1
    fi
    
    if [ $install_failed -eq 0 ]; then
        log_info "Packages installed successfully."
        
        if ! grep -q "25\.12" /etc/openwrt_release 2>/dev/null && ! grep -q "25\.12" /etc/os-release 2>/dev/null; then
            sed -i 's|/nas/|/services/|g' /usr/share/luci/menu.d/luci-app-samba4.json 2>/dev/null
        fi
    else
        log_error "Package installation failed!"
        return 1
    fi
    
    if [ ! -f /etc/config/samba4 ]; then
        touch /etc/config/samba4
    fi
    
    echo ""
    echo -n "Proceed with Samba4 setup? (y/n) [Auto: y in 5s]: "
    if read -t 5 -r setup_choice; then
        :
    else
        setup_choice="y"
        echo "y"
    fi
    
    case "$setup_choice" in
        [Nn])
            log_info "Installation complete. Samba4 is not configured."
            ;;
        *)
            add_samba4_user
            configure_samba4_path
            
            log_info "Enabling Samba4 service..."
            /etc/init.d/samba4 enable >/dev/null 2>&1
            /etc/init.d/samba4 restart >/dev/null 2>&1
            log_info "Samba4 configured and running successfully!"
            ;;
    esac
}

