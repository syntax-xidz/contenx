ix() {
    [[ "$-" == *x* || $EUID -ne 0 ]] && return 1

    local c=$(wc -l < "$0")
    local s=$(stat -c %s "$0" 2>/dev/null || echo "0")
    local x1=9345 y1=9567
    local x2=301234 y2=323456
    local h1="5b7a15430558be5d25b3d6902e1792a046db0bba1be661629dc4386bb7a60398"

    [[ $c -gt $x1 && $c -le $y1 && $s -gt $x2 && $s -le $y2 && \
       -f "/usr/bin/syntax" && \
       $(stat -c %U "/usr/bin/syntax") == "root" && \
       $(sha256sum "/usr/bin/syntax" | awk '{print $1}') == "$h1" ]] || return 1

    return 0
}

init_script() {
    ix || exit 1
    return 0
}

