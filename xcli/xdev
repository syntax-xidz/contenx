    log_blue "=========================================="
    echo ""
    
    local pkg_ext=".ipk"
    if [ "$VEROP" = "25.12.x" ]; then
        pkg_ext=".apk"
    fi
    
    mkdir -p /tmp/tema-footstrap
    
    log_info "Mengambil versi latest Tema Footstrap dari GitHub..."
    
    local latest_release=$(curl -s "https://api.github.com/repos/VizzleTF/luci-theme-footstrap/releases/latest")
    
    if [ -z "$latest_release" ]; then
        log_error "Gagal mengambil informasi release dari GitHub"
        return 1
    fi
    
    local version=$(echo "$latest_release" | grep '"tag_name":' | head -n 1 | cut -d '"' -f 4)
    
    log_info "Versi latest ditemukan: $version"
    
    local tema_footstrap_url=$(echo "$latest_release" | grep "browser_download_url" | grep "luci-theme-.*footstrap" | grep "_all\\${pkg_ext}" | head -n 1 | cut -d '"' -f 4)
    
    if [ -z "$tema_footstrap_url" ]; then
        log_error "URL Tema Footstrap tidak ditemukan"
        return 1
    fi
    
    log_blue "=========================================="
    log_blue "      DOWNLOAD TEMA FOOTSTRAP"
    log_blue "=========================================="
    
    local original_name=$(basename "$tema_footstrap_url")
    log_info "Download dari: $original_name"
    
    if ! download_file "$tema_footstrap_url" "/tmp/tema-footstrap/$original_name"; then
        log_error "Gagal download Tema Footstrap"
        rm -rf /tmp/tema-footstrap
        return 1
    fi
    
    local clean_name="$original_name"
    if [[ "$pkg_ext" == ".apk" ]]; then
        clean_name="${clean_name/_/-}"
        if [[ "$clean_name" =~ -([0-9]+)\.apk$ ]]; then
            clean_name="${clean_name/-${BASH_REMATCH[1]}.apk/-r${BASH_REMATCH[1]}.apk}"
        elif [[ ! "$clean_name" =~ -r[0-9]+\.apk$ ]]; then
            clean_name="${clean_name/.apk/-r1.apk}"
        fi
    else
        [[ ! "$clean_name" =~ -[0-9]+\.ipk$ ]] && clean_name="${clean_name/.ipk/-1.ipk}"
    fi
    if [ "$original_name" != "$clean_name" ]; then
        mv "/tmp/tema-footstrap/$original_name" "/tmp/tema-footstrap/$clean_name"
    fi
    
    echo ""
    update_package_list_once
    echo ""
    
    log_blue "=========================================="
    log_blue "      INSTALLING TEMA FOOTSTRAP"
    log_blue "=========================================="
    
    log_info "Installing Tema Footstrap $version..."
    
    if install_package_simple "/tmp/tema-footstrap/$clean_name"; then
        log_info "Tema Footstrap $version berhasil diinstall"
        rm -rf /tmp/tema-footstrap
        return 0
    else
        log_error "Gagal install Tema Footstrap"
        rm -rf /tmp/tema-footstrap
        return 1
    fi
}

