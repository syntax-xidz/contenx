    elif [ "$VEROP" = "23.05.x" ] || [ "$VEROP" = "24.10.x" ]; then
        pkg_ext=".ipk"
        owrt_ver="openwrt24"
    fi
    
    log_info "Target system: ${VEROP:-Unknown} -> utilizing ${owrt_ver} with ${pkg_ext} format."
    log_info "Fetching the latest Engsel release from GitHub..."
    
    local latest_release=$(curl -s "https://api.github.com/repos/As-tsaqib/luci-app-engsel/releases/latest")
    
    if [ -z "$latest_release" ]; then
        log_error "Failed to retrieve release information from GitHub."
        return 1
    fi
    
    local version=$(echo "$latest_release" | grep '"tag_name":' | head -n 1 | cut -d '"' -f 4)
    
    log_info "Latest version identified: $version"
    
    local search_pattern="${ARCH_3}-${owrt_ver}${pkg_ext}.zip"
    local engsel_url=$(echo "$latest_release" | grep "browser_download_url" | grep "$search_pattern" | head -n 1 | cut -d '"' -f 4)
    
    if [ -z "$engsel_url" ]; then
        log_error "Engsel download URL for architecture ${ARCH_3} (${search_pattern}) not found."
        return 1
    fi
    
    log_blue "=========================================="
    log_blue "         DOWNLOAD LUCI-APP-ENGSEL"
    log_blue "=========================================="
    
    log_info "Downloading from: $(basename "$engsel_url")"
    
    if ! download_file "$engsel_url" "/tmp/engsel/engsel_release.zip"; then
        log_error "Failed to download the Engsel zip archive."
        rm -rf /tmp/engsel
        return 1
    fi
    
    log_info "Extracting the zip archive..."
    unzip -q /tmp/engsel/engsel_release.zip -d /tmp/engsel/
    if [ $? -ne 0 ]; then
        log_error "Failed to extract the Engsel zip archive."
        rm -rf /tmp/engsel
        return 1
    fi
    
    for pkg_file in /tmp/engsel/*${pkg_ext}; do
        if [ -f "$pkg_file" ]; then
            local orig_name=$(basename "$pkg_file")
            local clean_name="$orig_name"
            if [[ "$pkg_ext" == ".apk" ]]; then
                clean_name="${clean_name/_/-}"
                if [[ "$clean_name" =~ -([0-9]+)\.apk$ ]]; then
                    clean_name="${clean_name/-${BASH_REMATCH[1]}.apk/-r${BASH_REMATCH[1]}.apk}"
                elif [[ ! "$clean_name" =~ -r[0-9]+\.apk$ ]]; then
                    clean_name="${clean_name/.apk/-r1.apk}"
                fi
            else
                [[ ! "$clean_name" =~ -[0-9]+\.ipk$ ]] && clean_name="${clean_name/.ipk/-1.ipk}"
            fi
            if [ "$orig_name" != "$clean_name" ]; then
                mv "/tmp/engsel/$orig_name" "/tmp/engsel/$clean_name"
            fi
        fi
    done
    
    echo ""
    update_package_list_once
    echo ""
    
    log_blue "=========================================="
