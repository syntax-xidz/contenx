update_package_list_once() {
    if [ "$VEROP" = "25.12.x" ]; then
        if [ "$PKG_UPDATE" = false ] || [ -z "$PKG_UPDATE" ]; then
            log_info "Memperbarui database packages..."
            if apk update >/dev/null 2>&1; then
                log_info "Database packages berhasil diperbarui"
                PKG_UPDATE=true
                save_config
            else
                log_warn "Gagal memperbarui database"
            fi
        fi
        return 0
    fi
    
    log_info "Memeriksa database opkg..."
    
    if [ -f /usr/lib/opkg/status ]; then
        if [ "$(tail -c1 /usr/lib/opkg/status | wc -l)" -eq 0 ]; then
            log_warn "Memperbaiki file status"
            echo "" >> /usr/lib/opkg/status
        fi
        
        log_info "Membersihkan database rusak"
        sed -i '/^Package: $/d' /usr/lib/opkg/status 2>/dev/null
        sed -i '/^Version: $/d' /usr/lib/opkg/status 2>/dev/null
    fi
    
    if [ "$PKG_UPDATE" = false ] || [ -z "$PKG_UPDATE" ]; then
        log_info "Memperbarui database packages..."
        if opkg update >/dev/null 2>&1; then
            log_info "Database packages berhasil diperbarui"
            PKG_UPDATE=true
            save_config
        else
            log_warn "Gagal memperbarui database"
        fi
    fi
}

check_dependencies() {
    if [ "$DEPENDS_XDEV" = true ]; then
        return 0
    fi

    log_info "Memeriksa dependensi..."
    
    local deps=("curl" "wget" "gzip" "unzip" "tar")
    local missing_deps=()
    
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            missing_deps+=("$dep")
        fi
    done
    
    if [ ${#missing_deps[@]} -gt 0 ]; then
        log_warn "Dependensi kurang: ${missing_deps[*]}"
        
        log_info "Menginstall dependensi..."
        for dep in "${missing_deps[@]}"; do
            if [ "$VEROP" = "25.12.x" ]; then
                apk add "$dep" >/dev/null 2>&1
            else
                opkg install "$dep" >/dev/null 2>&1
            fi
        done
        
        log_info "Dependensi berhasil diinstall"
    else
        log_info "Semua dependensi sudah terpenuhi"
    fi

    DEPENDS_XDEV=true
    save_config
}

rootfs_partsize_depends() {
    if [ "$ROOTFS_PARTSIZE_DEPS" = true ]; then
        return 0
    fi

    log_info "Memeriksa dependensi rootfs..."
    
    export PATH="/usr/sbin:/sbin:/usr/bin:/bin:$PATH"
    
    local pkg_resize2fs="resize2fs"
    if [ "$VEROP" = "25.12.x" ]; then
        pkg_resize2fs="e2fsprogs"
    fi

    local deps=(
        "parted:parted"
        "sfdisk:sfdisk"
        "lsblk:lsblk"
        "blkid:blkid"
        "tar:tar"
        "gzip:gzip"
        "resize2fs:$pkg_resize2fs"
        "mkfs.ext4:e2fsprogs"
        "btrfs:btrfs-progs"
        "mkfs.btrfs:btrfs-progs"
    )
    local missing_deps=()
    local missing_pkgs=()
    
    for item in "${deps[@]}"; do
        local cmd="${item%%:*}"
        local pkg="${item##*:}"
        
        if ! command -v "$cmd" &> /dev/null && [ ! -x "/sbin/$cmd" ] && [ ! -x "/usr/sbin/$cmd" ]; then
            missing_deps+=("$cmd")
            if [[ ! " ${missing_pkgs[*]} " =~ " ${pkg} " ]]; then
                missing_pkgs+=("$pkg")
            fi
        fi
    done
    
    if [ ${#missing_pkgs[@]} -gt 0 ]; then
        log_warn "Dependensi rootfs kurang: ${missing_deps[*]}"
        
        log_info "Menginstall dependensi rootfs..."
        for pkg in "${missing_pkgs[@]}"; do
            if [ "$VEROP" = "25.12.x" ]; then
                apk add "$pkg" >/dev/null 2>&1
            else
                opkg install "$pkg" >/dev/null 2>&1
            fi
        done
        
        log_info "Dependensi rootfs berhasil diinstall"
    else
        log_info "Semua dependensi rootfs sudah terpenuhi"
    fi

    ROOTFS_PARTSIZE_DEPS=true
    save_config
}

