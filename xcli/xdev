install_libernet() {
    log_blue "=========================================="
    log_blue "             INSTALL LIBERNET"
    log_blue "=========================================="
    echo ""

    local home_dir="/root"
    local libernet_dir="${home_dir}/libernet"
    local libernet_www="/www/libernet"
    local libernet_tmp="/tmp/libernet_install"

    mkdir -p "$libernet_tmp"

    echo ""
    update_package_list_once
    echo ""

    log_blue "=========================================="
    log_blue "           DOWNLOAD SOURCE CODE"
    log_blue "=========================================="
    
    log_info "Mengunduh source code Libernet..."
    curl -sL "https://github.com/lutfailham96/libernet/archive/refs/heads/main.tar.gz" -o "${libernet_tmp}/libernet.tar.gz"
    tar -xzf "${libernet_tmp}/libernet.tar.gz" -C "$libernet_tmp"
    
    cd "${libernet_tmp}/libernet-main" || {
        log_error "Gagal mengekstrak source code Libernet"
        rm -rf "$libernet_tmp"
        return 1
    }

    log_blue "=========================================="
    log_blue "       INSTALL PACKAGES & DEPENDENSI"
    log_blue "=========================================="
    
    log_info "Menginstall packages core sistem..."
    if [[ "$VEROP" == "25.12.x" ]]; then
        apk add php8 php8-cgi php8-mod-session v2ray-geodata https-dns-proxy dnsmasq-full httping >/dev/null 2>&1
    else
        opkg install php8 php8-cgi php8-mod-session v2ray-geodata https-dns-proxy dnsmasq-full httping >/dev/null 2>&1
    fi

    log_info "Menginstall packages dependensi..."
    while IFS= read -r pkg; do
        if [[ -n "$pkg" ]]; then
            if [[ "$VEROP" == "25.12.x" ]]; then
                if ! apk info -e "$pkg" >/dev/null 2>&1; then
                    apk add "$pkg" >/dev/null 2>&1
                fi
            else
                if ! opkg list-installed "$pkg" >/dev/null 2>&1; then
                    opkg install "$pkg" >/dev/null 2>&1
                fi
            fi
        fi
    done < requirements.txt

    log_info "Menginstall file binary proprietary..."
    while IFS= read -r bin; do
        if [[ -n "$bin" ]] && ! command -v "$bin" >/dev/null 2>&1; then
            curl -sLko "/usr/bin/${bin}" "https://github.com/lutfailham96/libernet-proprietary/raw/main/${ARCH_3}/binaries/${bin}" >/dev/null
            chmod +x "/usr/bin/${bin}"
        fi
    done < binaries.txt

    log_info "Menginstall packages proprietary tambahan..."
    while IFS= read -r pkg; do
        if [[ -n "$pkg" ]] && ! command -v "$pkg" >/dev/null 2>&1; then
            curl -sLko "${libernet_tmp}/${pkg}.ipk" "https://github.com/lutfailham96/libernet-proprietary/raw/main/${ARCH_3}/packages/${pkg}.ipk" >/dev/null
            install_package_simple "${libernet_tmp}/${pkg}.ipk" >/dev/null
        fi
    done < packages.txt

    log_blue "=========================================="
    log_blue "        KONFIGURASI SISTEM LIBERNET"
    log_blue "=========================================="
    
    log_info "Mengkonfigurasi layanan uHTTPd..."
    if ! grep -q ".php=/usr/bin/php-cgi" /etc/config/uhttpd; then
        uci add_list uhttpd.main.interpreter='.php=/usr/bin/php-cgi'
        uci add_list uhttpd.main.index_page='index.php'
        uci commit uhttpd
    fi

    log_info "Menyiapkan direktori sistem Libernet..."
    if [[ -f "${libernet_dir}/bin/service.sh" ]]; then
        "${libernet_dir}/bin/service.sh" -ds >/dev/null 2>&1
    fi

    rm -rf "$libernet_www"
    mkdir -p "$libernet_dir"
    mkdir -p "$libernet_www"

    cp -af update.sh "${libernet_dir}/"
    cp -arf bin "${libernet_dir}/"
    cp -arf system "${libernet_dir}/"
    cp -arf log "${libernet_dir}/"
    cp -arf web/* "${libernet_www}/"

    local esc_dir=$(echo "$libernet_dir" | sed 's/\//\\\//g')
    sed -i "s/LIBERNET_DIR/${esc_dir}/g" "${libernet_www}/config.inc.php"

    if ! grep -q LIBERNET_DIR /etc/profile; then
        printf "\nexport LIBERNET_DIR=%s\n" "$libernet_dir" >> /etc/profile
    fi

    log_info "Mengkonfigurasi aturan Firewall..."
    if ! uci get network.libernet >/dev/null 2>&1; then
        uci set network.libernet=interface
        uci set network.libernet.proto='none'
        uci set network.libernet.ifname='tun1'
        uci commit network

        uci add firewall zone
        uci set firewall.@zone[-1].network='libernet'
        uci set firewall.@zone[-1].name='libernet'
        uci set firewall.@zone[-1].masq='1'
        uci set firewall.@zone[-1].mtu_fix='1'
        uci set firewall.@zone[-1].input='REJECT'
        uci set firewall.@zone[-1].forward='REJECT'
        uci set firewall.@zone[-1].output='ACCEPT'

        uci add firewall forwarding
        uci set firewall.@forwarding[-1].src='lan'
        uci set firewall.@forwarding[-1].dest='libernet'
        uci commit firewall
    fi

    log_info "Menonaktifkan layanan yang bentrok..."
    for svc in stubby shadowsocks-libev openvpn stunnel; do
        if [[ -f "/etc/init.d/$svc" ]]; then
            /etc/init.d/$svc disable >/dev/null 2>&1
        fi
    done

    log_blue "=========================================="
    log_blue "          INTEGRASI MENU LUCI UI"
    log_blue "=========================================="
    
    if [[ "$VEROP" == "25.12.x" ]]; then
        if ! apk info -e luci-compat >/dev/null 2>&1; then
            apk add luci-compat >/dev/null 2>&1
        fi
    else
        if ! opkg list-installed luci-compat >/dev/null 2>&1; then
            opkg install luci-compat >/dev/null 2>&1
        fi
    fi

    log_info "Menyiapkan LuCI Controller..."
    mkdir -p /usr/lib/lua/luci/controller
    cat <<'EOF' >/usr/lib/lua/luci/controller/libernet.lua
module("luci.controller.libernet", package.seeall)
function index()
    entry({"admin","services","libernet"}, view("libernet"), _("Libernet"), 55).leaf = true
end
EOF

    log_info "Menyiapkan LuCI View..."
    mkdir -p /www/luci-static/resources/view
    cat <<'EOF' >/www/luci-static/resources/view/libernet.js
'use strict';
'require view';

return view.extend({
  render: function() {
    return E('div', { 'class': 'cbi-section' }, [
      E('h2', {}, 'Libernet'),
      E('iframe', {
        id: 'libernet',
        src: window.location.protocol + '//' + window.location.hostname + '/libernet',
        style: 'width:100%;min-height:650px;border:none;border-radius:2px;'
      })
    ]);
  }
});
EOF

    log_blue "=========================================="
    log_blue "          INSTALL LIBERNET MOD"
    log_blue "=========================================="
    
    log_info "Mengunduh file Libernet Mod..."
    curl -sL "https://raw.githubusercontent.com/syntax-xidz/contenx/main/xcli/libernet-mod.tar.gz" -o "/tmp/libernet-mod.tar.gz" >/dev/null

    log_info "Mengekstrak dan menerapkan Libernet Mod..."
    rm -rf "$libernet_dir"
    rm -rf "$libernet_www"
    
    tar -xzf "/tmp/libernet-mod.tar.gz" -C / >/dev/null 2>&1
    rm -f "/tmp/libernet-mod.tar.gz"

    mkdir -p "$libernet_dir"
    mkdir -p "$libernet_www"
    chmod -R 755 "$libernet_dir"
    chmod -R 755 "$libernet_www"

    if [[ -f "${libernet_www}/config.inc.php" ]]; then
        sed -i "s/LIBERNET_DIR/${esc_dir}/g" "${libernet_www}/config.inc.php"
    fi

    mkdir -p "${libernet_dir}/log"
    touch "${libernet_dir}/log/status.log" 2>/dev/null
    touch "${libernet_dir}/log/service.log" 2>/dev/null
    touch "${libernet_dir}/log/connected.log" 2>/dev/null

    log_info "Memuat ulang layanan dan membersihkan cache..."
    rm -f /tmp/luci-indexcache* >/dev/null 2>&1
    rm -rf /tmp/luci-modulecache >/dev/null 2>&1
    /etc/init.d/rpcd restart >/dev/null
    /etc/init.d/uhttpd restart >/dev/null
    /etc/init.d/network restart >/dev/null

    local ip=$(ifconfig br-lan | grep 'inet ' | awk '{print $2}' | sed 's/addr://')
    
    echo ""
    log_blue "=========================================="
    log_info "✓ Libernet Mod berhasil diinstall"
    log_info "✓ Akses antarmuka: http://${ip}/libernet"
    log_blue "=========================================="
    echo ""

    cd /
    rm -rf "$libernet_tmp"
    return 0
}

uninstall_libernet() {
    log_blue "=========================================="
    log_blue "            UNINSTALL LIBERNET"
    log_blue "=========================================="
    echo ""

    local home_dir="/root"
    local libernet_dir="${home_dir}/libernet"
    local libernet_www="/www/libernet"
    local tmp_uninstall="/tmp/libernet_uninstall"

    if [[ -f "${libernet_dir}/bin/service.sh" ]]; then
        log_info "Menghentikan layanan Libernet yang berjalan..."
        "${libernet_dir}/bin/service.sh" -ds >/dev/null 2>&1
    fi

    log_info "Mengambil daftar file untuk pembersihan..."
    mkdir -p "$tmp_uninstall"
    curl -sL "https://raw.githubusercontent.com/lutfailham96/libernet/main/binaries.txt" -o "${tmp_uninstall}/binaries.txt" >/dev/null
    curl -sL "https://raw.githubusercontent.com/lutfailham96/libernet/main/packages.txt" -o "${tmp_uninstall}/packages.txt" >/dev/null

    log_info "Menghapus packages proprietary tambahan..."
    if [[ -f "${tmp_uninstall}/packages.txt" ]]; then
        while IFS= read -r pkg; do
            if [[ -n "$pkg" ]]; then
                if [[ "$VEROP" == "25.12.x" ]]; then
                    if apk info -e "$pkg" >/dev/null 2>&1; then
                        apk del "$pkg" >/dev/null 2>&1
                    fi
                else
                    if opkg list-installed "$pkg" >/dev/null 2>&1; then
                        opkg remove "$pkg" >/dev/null 2>&1
                    fi
                fi
            fi
        done < "${tmp_uninstall}/packages.txt"
    fi

    log_info "Menghapus packages v2ray-geodata dan v2ray..."
    for v_pkg in v2ray-geodata v2ray-core v2ray; do
        if [[ "$VEROP" == "25.12.x" ]]; then
            if apk info -e "$v_pkg" >/dev/null 2>&1; then
                apk del "$v_pkg" >/dev/null 2>&1
            fi
        else
            if opkg list-installed "$v_pkg" >/dev/null 2>&1; then
                opkg remove "$v_pkg" >/dev/null 2>&1
            fi
        fi
    done

    log_info "Menghapus file binary proprietary..."
    if [[ -f "${tmp_uninstall}/binaries.txt" ]]; then
        while IFS= read -r bin; do
            if [[ -n "$bin" ]] && [[ -f "/usr/bin/${bin}" ]]; then
                rm -f "/usr/bin/${bin}"
            fi
        done < "${tmp_uninstall}/binaries.txt"
    fi

    log_info "Menghapus direktori sistem Libernet..."
    rm -rf "$libernet_dir"
    rm -rf "$libernet_www"
    rm -rf "$tmp_uninstall"
    rm -f /usr/lib/lua/luci/controller/libernet.lua
    rm -f /www/luci-static/resources/view/libernet.js

    log_info "Membersihkan variabel environment..."
    sed -i '/# Libernet/d' /etc/profile
    sed -i '/export LIBERNET_DIR/d' /etc/profile

    log_info "Membersihkan konfigurasi uHTTPd..."
    if grep -q ".php=/usr/bin/php-cgi" /etc/config/uhttpd; then
        uci del_list uhttpd.main.index_page='index.php' >/dev/null 2>&1
        uci delete uhttpd.main.interpreter >/dev/null 2>&1
        uci commit uhttpd
    fi

    log_info "Membersihkan konfigurasi Firewall..."
    if uci get network.libernet >/dev/null 2>&1; then
        uci delete network.libernet
        uci commit network
    fi

    local zone_idx=$(uci show firewall | grep -E "firewall\.@zone\[[0-9]+\]\.name='libernet'" | sed -E 's/.*\[([0-9]+)\].*/\1/')
    if [[ -n "$zone_idx" ]]; then
        uci delete firewall.@zone[$zone_idx]
        uci commit firewall
    fi

    local fwd_idx=$(uci show firewall | grep -E "firewall\.@forwarding\[[0-9]+\]\.dest='libernet'" | sed -E 's/.*\[([0-9]+)\].*/\1/')
    if [[ -n "$fwd_idx" ]]; then
        uci delete firewall.@forwarding[$fwd_idx]
        uci commit firewall
    fi

    log_info "Memuat ulang layanan dan membersihkan cache..."
    rm -f /tmp/luci-indexcache* >/dev/null 2>&1
    rm -rf /tmp/luci-modulecache >/dev/null 2>&1
    /etc/init.d/rpcd restart >/dev/null
    /etc/init.d/uhttpd restart >/dev/null
    /etc/init.d/network restart >/dev/null

    echo ""
    log_blue "=========================================="
    log_info "✓ Libernet berhasil dihapus"
    log_blue "=========================================="
    echo ""
    return 0
}

install_engsel() {
